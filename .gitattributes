# Normalize line endings to LF in the repository for all text files.
* text=auto eol=lf

# Explicitly text (so diffs render as text).
*.swift text
*.sh    text eol=lf
*.md    text

# Binary assets: never attempt to diff or normalise them.
*.icns binary
*.jpg  binary
*.png  binary

# Generated build output is noise in diffs and language statistics.
build/** linguist-generated=true
